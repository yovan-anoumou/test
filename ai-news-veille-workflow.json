    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "assign-prompt",
              "name": "prompt",
              "value": "={{ 'Tu es un expert en intelligence artificielle. Analyse et résume cet article en français.\\n\\nTitre : ' + $json.title + '\\n\\nContenu : ' + ($json.contentSnippet || $json.content || '(contenu non disponible)').substring(0, 3000) + '\\n\\nRédige un résumé en 3 à 5 phrases couvrant :\\n1. Ce qui est nouveau ou annoncé\\n2. L\\'impact potentiel\\n3. Les points clés à retenir\\n\\nSois concis et factuel. Ne commence pas par \"Bien sûr\" ou \"Certainement\".' }}",
              "type": "string"
            },
            {
              "id": "assign-title",
              "name": "title",
              "value": "={{ $json.title }}",
              "type": "string"
            },
            {
              "id": "assign-link",
              "name": "link",
              "value": "={{ $json.link }}",
              "type": "string"
            },
            {
              "id": "assign-source",
