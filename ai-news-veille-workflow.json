      "id": "aa000010-0000-0000-0000-000000000010",
      "name": "Merge All Feeds",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [720, 430]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst cutoff = new Date(now.getTime() - 24 * 60 * 60 * 1000);\n\nconst SOURCE_MAP = {\n  'openai.com': 'OpenAI',\n  'anthropic.com': 'Anthropic',\n  'deepmind.google': 'Google DeepMind',\n  'blog.google': 'Google AI Blog',\n  'ai.meta.com': 'Meta AI',\n  'huggingface.co': 'Hugging Face',\n  'techcrunch.com': 'TechCrunch AI',\n  'theverge.com': 'The Verge AI'\n};\n\nfunction getSource(link) {\n  try {\n    const hostname = new URL(link).hostname.replace('www.', '');\n    for (const [key, val] of Object.entries(SOURCE_MAP)) {\n      if (hostname.includes(key)) return val;\n    }\n  } catch(e) {}\n  return 'Source IA';\n}\n\nconst filtered = items.filter(item => {\n  const dateStr = item.json.isoDate || item.json.pubDate;\n  if (!dateStr) return false;\n  return new Date(dateStr) >= cutoff;\n});\n\nreturn filtered.map(item => ({\n  json: {\n    ...item.json,\n    sourceName: getSource(item.json.link || ''),\n    articleDate: new Date(item.json.isoDate || item.json.pubDate).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' })\n  }\n}));"
      },
      "id": "aa000011-0000-0000-0000-000000000011",
      "name": "Filtrer 24h",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 430]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-articles-found",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt",
                "name": "filter.operator.gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "aa000012-0000-0000-0000-000000000012",
      "name": "IF Articles Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1200, 430]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID || 'YOUR_CHAT_ID' }}",
        "text": "={{ '🤖 <b>Veille IA du ' + new Date().toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' }) + '</b>\\n\\n📊 <b>' + $input.all().length + ' article' + ($input.all().length > 1 ? 's' : '') + ' trouvé' + ($input.all().length > 1 ? 's' : '') + ' dans les dernières 24h</b>\\n\\n🔎 Sources surveillées : OpenAI · Anthropic · DeepMind · Google AI · Meta AI · Hugging Face · TechCrunch · The Verge' }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "aa000013-0000-0000-0000-000000000013",
      "name": "Telegram Header",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1440, 330],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
